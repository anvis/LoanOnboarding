{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "extensions": {
    "serviceBus": {
      "maxConcurrentSessions": 16,
      "maxConcurrentCalls": 16,
      "sessionIdleTimeout": "00:00:30",
      "maxAutoLockRenewalDuration": "00:05:00"
    }
  }
}

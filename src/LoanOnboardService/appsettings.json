{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Sql": "REPLACE_WITH_SQL_CONNECTION_STRING",
    "BlobStorage": "REPLACE_WITH_BLOB_STORAGE_CONNECTION_STRING"
  },

  "Blob": {
    "ContainerName": "loan-documents",
    "ServiceUri": ""
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "REPLACE_WITH_TENANT_ID",
    "ClientId": "REPLACE_WITH_API_APP_CLIENT_ID",
    "Audience": "api://REPLACE_WITH_API_APP_CLIENT_ID"
  },

  "Auth": {
    "DevBypass": false
  },

  "Documents": {
    "MaxBytes": 10485760,
    "MinRequired": 1
  },

  "Loan": {
    "StageValidityHours": 72,
    "SecondApproverThreshold": 50000,
    "MaxStageAttempts": 3,
    "IdentifierHashKey": "REPLACE_WITH_RANDOM_SECRET"
  }
}
